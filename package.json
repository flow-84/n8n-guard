{
  "name": "n8n-guard",
  "version": "0.1.0",
  "mcpName": "io.github.flow-84/n8n-guard",
  "description": "MCP server for the operational layer beneath the n8n Public API: disk, retention, stuck executions, git drift.",
  "license": "MIT",
  "author": "flow-84",
  "homepage": "https://github.com/flow-84/n8n-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flow-84/n8n-guard.git"
  },
  "bugs": {
    "url": "https://github.com/flow-84/n8n-guard/issues"
  },
  "type": "module",
  "bin": {
    "n8n-guard": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run",
    "start:workflow": "node dist/workflow/index.js",
    "workflow:trigger": "node dist/workflow/trigger.js"
  },
  "keywords": [
    "mcp",
    "n8n",
    "monitoring",
    "sre",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@renderinc/sdk": "^1.0.0",
    "pg": "^8.13.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
